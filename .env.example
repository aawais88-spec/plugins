# External AI Model API Keys
# Copy this file to .env and fill in your actual keys

# OpenRouter (access 100+ models)
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Together AI (fast inference)
# Get key from: https://www.together.ai/
TOGETHER_API_KEY=your_together_key_here

# Replicate (vision models, image generation)
# Get key from: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_key_here

# Local Development
# These are always available
CLAUDE_HAIKU_ENABLED=true
CLAUDE_SONNET_ENABLED=true
CLAUDE_OPUS_ENABLED=true

# Optional: Default model for requests
DEFAULT_MODEL=claude-haiku-4-5-20251001

# Optional: Max tokens per request
MAX_TOKENS=2000

# Optional: Log all API calls
LOG_API_CALLS=true
